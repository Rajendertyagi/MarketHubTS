# MarketHubTS runtime configuration
# Copy to .env for local overrides (do not commit .env).

# Environment: development | production | test
MARKETHUB_ENV=development

# API server
MARKETHUB_HOST=127.0.0.1
# PORT is also supported for compatibility
MARKETHUB_PORT=3001

# LAN mode: when true, bind host defaults to 0.0.0.0 unless MARKETHUB_HOST is explicitly set
MARKETHUB_LAN=false

# SQLite database path (relative to process working directory or absolute)
MARKETHUB_DB_PATH=./data/markethub.sqlite

# Logging: debug | info | warn | error
MARKETHUB_LOG_LEVEL=info

# Web UI (development)
MARKETHUB_WEB_HOST=127.0.0.1
MARKETHUB_WEB_PORT=5173

# API base URL used by MCP server and external clients
MARKETHUB_API_URL=http://localhost:3001
