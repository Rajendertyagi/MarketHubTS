      "checkConstraints": {
        "derivative_contracts_future_shape_ck": {
          "name": "derivative_contracts_future_shape_ck",
          "value": "(\n        (\"derivative_contracts\".\"derivative_class\" IN ('STOCK_FUTURE','INDEX_FUTURE') AND \"derivative_contracts\".\"strike_normalized\" IS NULL AND \"derivative_contracts\".\"option_type\" IS NULL AND \"derivative_contracts\".\"strike_key\" = '' AND \"derivative_contracts\".\"option_type_key\" = '')\n        OR\n        (\"derivative_contracts\".\"derivative_class\" IN ('STOCK_OPTION','INDEX_OPTION') AND \"derivative_contracts\".\"strike_normalized\" IS NOT NULL AND \"derivative_contracts\".\"option_type\" IN ('CE','PE') AND \"derivative_contracts\".\"strike_key\" <> '' AND \"derivative_contracts\".\"option_type_key\" IN ('CE','PE') AND CAST(\"derivative_contracts\".\"strike_normalized\" AS REAL) > 0)\n      )"
        },
        "derivative_contracts_lot_size_ck": {
          "name": "derivative_contracts_lot_size_ck",
          "value": "(\"derivative_contracts\".\"lot_size\" IS NULL OR \"derivative_contracts\".\"lot_size\" > 0)"
        },
        "derivative_contracts_quantity_freeze_ck": {
          "name": "derivative_contracts_quantity_freeze_ck",
          "value": "(\"derivative_contracts\".\"quantity_freeze\" IS NULL OR \"derivative_contracts\".\"quantity_freeze\" > 0)"
        },
        "derivative_contracts_tick_size_ck": {
          "name": "derivative_contracts_tick_size_ck",
          "value": "(\"derivative_contracts\".\"tick_size\" IS NULL OR CAST(\"derivative_contracts\".\"tick_size\" AS REAL) > 0)"
        }
      }
    },
