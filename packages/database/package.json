{
  "name": "@markethub/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts"
  },
  "dependencies": {
    "@markethub/contracts": "workspace:*",
    "@markethub/market-core": "workspace:*",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
