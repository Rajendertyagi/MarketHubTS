{
  "name": "markethubts",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:web": "bun --cwd apps/web dev",
    "dev:mcp": "bun --cwd apps/mcp-server dev",
    "build": "bun run build:packages && bun run build:apps",
    "build:packages": "bun run --filter './packages/*' build",
    "build:apps": "bun run --filter './apps/*' build",
    "start": "bun scripts/start.ts",
    "start:api": "bun --cwd apps/api start",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "db:generate": "bun --cwd packages/database db:generate",
    "db:migrate": "bun --cwd packages/database db:migrate"
  },
  "devDependencies": {
    "bun-types": "1.4.4",
    "typescript": "7.0.2"
  }
}
